DATABASE_URL="postgresql://erp:erp_dev_password@localhost:5432/restaurant_erp"
JWT_SECRET="change-me"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
PORT=3000

# ZATCA (Phase 9) -- ZATCA_KEYS_DIR holds the local EC key pair used to sign
# invoices (auto-generated on first use if missing; a real deployment
# replaces it with a CSID-issued key from ZATCA's own onboarding). Leave
# ZATCA_API_BASE_URL unset until real ZATCA credentials exist -- submitting
# invoices then honestly fails instead of faking success (src/zatca/zatca.service.ts).
ZATCA_KEYS_DIR=".zatca-keys"
# ZATCA_API_BASE_URL=
