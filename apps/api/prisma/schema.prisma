// ============================================================================
// Restaurant ERP — مخطط قاعدة البيانات
// هذا مخطط أولي (scaffold) يغطي القرارات المعمارية في docs/DECISIONS.md
// لم يُختبر بعد بـ migration فعلي — راجعه وعدّله قبل أول migrate.
// ============================================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ---------------------------------------------------------------------------
// المواقع (فروع + مطبخ مركزي) — القرار #1, #5
// ---------------------------------------------------------------------------
enum LocationType {
  BRANCH
  CENTRAL_KITCHEN
  WAREHOUSE
}

model Location {
  id                       String       @id @default(cuid())
  name                     String
  type                     LocationType
  address                  String?
  // ZATCA (Phase 9): the seller's VAT registration number that goes into
  // every invoice issued from this location. Invoice generation is skipped
  // (not failed -- a sale should never be blocked by a missing setting)
  // when this isn't set; see ZatcaService.generateForOrder.
  vatNumber                String?
  // ZATCA Invoice Counter Value (ICV): a simple, monotonically increasing
  // integer identifying this location's Nth reported invoice -- required
  // alongside the Previous Invoice Hash (PIH) chain on Order below so each
  // invoice's XML can reference "invoice N-1 at this location" per ZATCA's
  // chaining rule. Incremented atomically inside ZatcaService.generateForOrder.
  zatcaInvoiceCounter      Int          @default(0)
  // Configurable per branch (not a global switch) -- a delivery-only dark
  // kitchen branch that always needs a customer for handoff/loyalty is a
  // different case from a walk-in dine-in branch that mostly doesn't.
  // Enforced server-side in OrdersService.create(), not just in the UI.
  requireCustomerForOrders Boolean      @default(false)
  // Percentage (e.g. 15.00 for 15%), replacing what used to be a single
  // hardcoded 0.15 constant duplicated across OrdersService/ZatcaService/
  // the admin panel's invoice renderer. One rate per branch (not per item)
  // per the simplest-viable design -- still lets each branch configure a
  // different rate if it operates under a different tax jurisdiction.
  vatRate                  Decimal      @default(15) @db.Decimal(5, 2)
  // When true, MenuItem.price / MenuItemChannelPrice.price are the FINAL
  // price the customer pays (VAT already baked in) -- OrdersService.create()
  // extracts the VAT portion out of that price for reporting/ZATCA instead
  // of adding it on top, and the invoice/cart never show a higher total
  // than the price on the menu. Default false preserves the original
  // tax-exclusive behavior (VAT added at checkout) for existing branches.
  pricesIncludeVat         Boolean      @default(false)
  // Lets this branch keep selling a menu item past zero stock instead of
  // OrdersService rejecting the order -- an explicit per-branch opt-in
  // (default off) since oversold stock is a real operational risk most
  // branches should NOT silently accept.
  allowNegativeStock       Boolean      @default(false)
  // A negative-stock sale of ANY ingredient a menu item's recipe needs can
  // optionally roll its shortfall into an auto-generated PLANNED
  // production order (see ProductionOrdersService.applyShortfall) --
  // rolling every negative sale of the same ingredient within one shift
  // into ONE open order instead of one per invoice. When this is on,
  // OrdersService.create() also lets that ingredient sell past zero EVEN
  // IF allowNegativeStock above is off -- covers every menu item, not
  // just ones built on a SEMI_FINISHED component: a SEMI_FINISHED
  // ingredient with its own registered recipe gets a real BOM on the
  // order, while a RAW_MATERIAL (or a SEMI_FINISHED item with no recipe
  // of its own) gets one with no inputs -- a plain "go restock/buy N
  // more" alert, since there's nothing to "produce" it from automatically.
  // Off by default, same "explicit per-branch opt-in" precedent as
  // allowNegativeStock above.
  autoGenerateProductionOrders Boolean  @default(false)
  // Per-branch invoice/receipt customization -- logo stored the same way
  // MenuItem.imageData is (bytea, no object storage configured here);
  // header/footer are free text printed above/below the line items on the
  // cashier invoice (e.g. a welcome line, a return policy, social handles).
  // All optional: an invoice prints fine with none of this set.
  logoData                 Bytes?
  logoMimeType             String?
  invoiceHeaderNote        String?
  invoiceFooterNote        String?
  // Human-friendly "SH{n}" shift number, per location (1, 2, 3, ...) --
  // separate from Shift.id (a cuid, meaningless to a cashier) and never
  // reused across locations. Incremented atomically inside ShiftsService.open()
  // the same way zatcaInvoiceCounter/dailyInvoiceCounter already are.
  lastShiftNumber          Int          @default(0)
  // A forgotten-open shift (cashier went home without closing) otherwise
  // blocks next-day reconciliation indefinitely -- when enabled, the
  // ShiftAutoCloseService cron force-closes any shift still open past
  // autoCloseCutoffHour local time on a later calendar day (zero variance:
  // closingCounted = expectedCash, closedById null marks it auto), then
  // performs end-of-day closing for that business date if it wasn't done
  // manually either. Off by default -- a real operational change, not a
  // silent default, per the same "explicit per-branch opt-in" precedent as
  // allowNegativeStock above.
  autoCloseEnabled         Boolean      @default(false)
  autoCloseCutoffHour      Int          @default(4)
  // Both set together (or both left null) -- this branch's fiscal
  // year-end (e.g. month=12, day=31). computeBusinessDate() (common/
  // business-date.util.ts) reuses autoCloseCutoffHour above as the "day
  // boundary hour" for EVERY order/shift, not just the auto-close cron:
  // a shift opened before the cutoff and still running past midnight
  // keeps every order on the SAME business date it opened on. These two
  // fields are the one deliberate exception to that rule -- when the
  // rolled-back business date would land exactly on the fiscal year-end,
  // the roll-back is suspended so the first hours of the new fiscal year
  // are never folded into the old year's last business day. Null (the
  // default) means the exception never applies.
  fiscalYearEndMonth       Int?
  fiscalYearEndDay         Int?
  isActive                 Boolean      @default(true)
  createdAt                DateTime     @default(now())

  inventoryBalances InventoryBalance[]
  inventoryBatches  InventoryBatch[]
  ordersAsSource    Order[]             @relation("OrderLocation")
  purchaseOrders    PurchaseOrder[]
  productionOrders  ProductionOrder[]
  transfersFrom     Transfer[]          @relation("TransferFrom")
  transfersTo       Transfer[]          @relation("TransferTo")
  stocktakes        Stocktake[]
  shifts            Shift[]
  users             UserLocationScope[]
  dayCloses         DayClose[]
}

// نهاية اليوم (Day Close) — سجل رسمي يجمع كل ورديات الفرع المغلقة عن يوم
// عمل واحد (businessDate)، سواء أُغلق يدويًا من لوحة التحكم أو تلقائيًا عبر
// ShiftAutoCloseService عند تفعيل autoCloseEnabled. واحد فقط لكل (فرع، يوم)
// -- إغلاق ثانٍ لنفس اليوم يُحدّث نفس السجل بدل تكرار الإحصائيات.
model DayClose {
  id            String   @id @default(cuid())
  locationId    String
  businessDate  DateTime @db.Date
  closedAt      DateTime @default(now())
  closedById    String?
  autoClosed    Boolean  @default(false)
  shiftsCount   Int
  totalRevenue  Decimal  @db.Decimal(12, 2)
  totalVariance Decimal  @db.Decimal(12, 2)
  createdAt     DateTime @default(now())

  location Location @relation(fields: [locationId], references: [id])
  closedBy User?    @relation(fields: [closedById], references: [id])

  @@unique([locationId, businessDate])
}

// ---------------------------------------------------------------------------
// المستخدمون والصلاحيات (RBAC مرن مع Scope) — القرار #16
// ---------------------------------------------------------------------------
model User {
  id           String   @id @default(cuid())
  name         String
  phone        String   @unique
  // Optional alternate login identifier -- AuthService.validateCredentials()
  // accepts either the phone number OR this username in the SAME "phone"
  // login field (no wire/API shape change needed for existing clients).
  // Null for users who only ever log in with their phone number.
  username     String?  @unique
  passwordHash String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  roles                   UserRole[]
  locationScopes          UserLocationScope[]
  shiftsOpened            Shift[]                  @relation("ShiftOpenedBy")
  shiftsClosed            Shift[]                  @relation("ShiftClosedBy")
  ordersServed            Order[]                  @relation("OrderServedBy")
  approvals               Approval[]
  returnsCreated          OrderReturn[]
  purchaseReturnsCreated  PurchaseReturn[]
  orderActivityLogs       OrderActivityLog[]
  orderReturnActivityLogs OrderReturnActivityLog[]
  dayClosesClosed         DayClose[]
}

model Role {
  id          String  @id @default(cuid())
  name        String  @unique // مثال: "مدير فرع"، "كاشير"، "مشرف مشتريات إقليمي"
  description String?

  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id    String @id @default(cuid())
  code  String @unique // مثال: "pos.void_order", "purchasing.approve_po", "inventory.adjust"
  label String

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
}

// نطاق صلاحية المستخدم: فرع معيّن / كل الفروع / مطبخ مركزي...
model UserLocationScope {
  userId     String
  locationId String
  user       User     @relation(fields: [userId], references: [id])
  location   Location @relation(fields: [locationId], references: [id])

  @@id([userId, locationId])
}

// ---------------------------------------------------------------------------
// المواد الخام والمنتجات النصف مصنّعة — القرار #4, #9
// ---------------------------------------------------------------------------
enum ValuationMethod {
  WEIGHTED_AVERAGE
  FIFO
}

enum IngredientKind {
  RAW_MATERIAL // مادة خام تُشترى مباشرة
  SEMI_FINISHED // منتج وسيط ينتج بأمر إنتاج (مثل صلصة مجهّزة)
}

// كتالوج وحدات القياس -- Ingredient.unit يبقى نصًا حرًا (لا يُهاجَر إلى FK
// لتفادي مخاطرة ترحيل بيانات كل صنف حالي)، لكن شاشة الأصناف تختار منه بدل
// إدخال نص حر، وهذا الموديل نفسه قابل للإدارة (إضافة/تعطيل) من شاشة مستقلة.
model UnitOfMeasure {
  id        String   @id @default(cuid())
  code      String   @unique // مثال: g, kg, ml, l, pcs
  name      String // مثال: "جرام"، "كيلوجرام"، "مليلتر"، "لتر"، "قطعة"
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Ingredient {
  id                String          @id @default(cuid())
  name              String
  category          String? // تصنيف حر (خضروات، لحوم، ألبان...) -- نفس نمط MenuItem.category لكن اختياري لأن الأصناف الموجودة مسبقًا ليس لها تصنيف
  unit              String // g, ml, pcs...
  kind              IngredientKind  @default(RAW_MATERIAL)
  valuationMethod   ValuationMethod @default(WEIGHTED_AVERAGE) // القرار #9: لكل صنف طريقته
  // تكلفة تقديرية لكل وحدة تُدخَل عند تعريف الصنف، قبل وجود أي دفعة مخزون
  // حقيقية له -- تُستخدم فقط كبديل احتياطي في حساب التكلفة النظرية
  // (menuItemCostsCore) لحد ما أول عملية شراء/إنتاج فعلية تُنشئ دفعة
  // حقيقية؛ من هذه اللحظة تكلفة الدفعات الفعلية هي المرجع دائمًا، وهذا
  // الحقل لا يُقرأ بعدها إطلاقًا (ليست قيمة تُخلَط في متوسط مرجّح حقيقي).
  openingCost       Decimal?        @db.Decimal(12, 4)
  lowStockThreshold Decimal         @db.Decimal(12, 3)
  shelfLifeDays     Int? // لحساب تاريخ الصلاحية الافتراضي عند الإنتاج/الاستلام
  createdAt         DateTime        @default(now())

  batches           InventoryBatch[]
  recipeUsages      RecipeLine[]          @relation("RecipeIngredient")
  // This ingredient's OWN recipe -- only meaningful when kind==SEMI_FINISHED
  // (e.g. "صلصة طماطم جاهزة" is itself made from tomatoes + salt). This is
  // what actually makes the BOM multi-level: a RecipeLine's ingredientId
  // can point at another SEMI_FINISHED ingredient, whose own ownRecipe
  // says what THAT is made from, and so on.
  ownRecipe         RecipeLine[]          @relation("IngredientOwnRecipe")
  purchaseLines     PurchaseOrderLine[]
  productionOutputs ProductionOrder[]     @relation("ProductionOutput")
  productionInputs  ProductionOrderLine[]
  transferLines     TransferLine[]
  stocktakeLines    StocktakeLine[]
}

// دفعة مخزون فعلية — إلزامي بغض النظر عن طريقة التقييم (القرار #9)
model InventoryBatch {
  id           String    @id @default(cuid())
  ingredientId String
  locationId   String
  batchNumber  String
  quantity     Decimal   @db.Decimal(12, 3) // الرصيد المتبقي من هذه الدفعة
  unitCost     Decimal   @db.Decimal(12, 4) // تكلفة الوحدة لهذه الدفعة تحديدًا (لأجل FIFO)
  receivedAt   DateTime  @default(now())
  expiresAt    DateTime?
  sourceType   String // "PURCHASE" | "PRODUCTION" | "TRANSFER" | "ADJUSTMENT"
  sourceId     String? // معرف المستند المصدر (PO / ProductionOrder / Transfer / Stocktake)

  ingredient Ingredient      @relation(fields: [ingredientId], references: [id])
  location   Location        @relation(fields: [locationId], references: [id])
  movements  StockMovement[]
}

// سجل حركة مخزون — كل خصم/إضافة يُسجَّل هنا (ledger)، لا تُعدَّل الأرصدة مباشرة
model StockMovement {
  id        String   @id @default(cuid())
  batchId   String
  quantity  Decimal  @db.Decimal(12, 3) // موجب = إضافة، سالب = خصم
  reason    String // "SALE" | "PRODUCTION_CONSUMPTION" | "TRANSFER_OUT" | "TRANSFER_IN" | "STOCKTAKE_ADJUSTMENT" | "WASTE"
  refId     String? // معرف الطلب/أمر الإنتاج/... المرتبط
  createdAt DateTime @default(now())

  batch InventoryBatch @relation(fields: [batchId], references: [id])
}

// رصيد مجمّع لكل صنف بكل موقع (للقراءة السريعة، يُشتق من InventoryBatch)
model InventoryBalance {
  id           String   @id @default(cuid())
  ingredientId String
  locationId   String
  quantity     Decimal  @db.Decimal(12, 3)
  updatedAt    DateTime @updatedAt

  location Location @relation(fields: [locationId], references: [id])

  @@unique([ingredientId, locationId])
}

// ---------------------------------------------------------------------------
// أصناف المبيعات والوصفات (Multi-level BOM) — القرار #4
// ---------------------------------------------------------------------------
// STANDARD: الفرع نسبته الاعتيادية (Location.vatRate). ZERO_RATED: خاضع
// للضريبة اسميًا لكن بنسبة 0% (مثال: بعض الصادرات) -- يظهر كسطر ضريبة صفري
// منفصل عن الإعفاء لأغراض تقرير الضرائب. EXEMPT: خارج نطاق الضريبة تمامًا.
enum TaxType {
  STANDARD
  ZERO_RATED
  EXEMPT
}

model MenuItem {
  id            String  @id @default(cuid())
  name          String
  category      String
  price         Decimal @db.Decimal(10, 2)
  isActive      Boolean @default(true)
  // Per-item override of the branch's default VAT treatment -- most items
  // are STANDARD (taxed at Location.vatRate); ZERO_RATED/EXEMPT items
  // contribute no VAT to an order line regardless of branch rate. Read by
  // OrdersService.create() to compute vatTotal per line instead of a flat
  // location-wide rate, and by AnalyticsService's tax report.
  taxType       TaxType @default(STANDARD)
  // Stored directly in Postgres (bytea), same choice already made for
  // GeneratedReport.fileData -- no cloud object storage credentials exist
  // in this environment, and a menu item photo is small enough (a few
  // hundred KB at most, enforced by the upload endpoint) that this isn't
  // the scaling liability it would be for larger files.
  imageData     Bytes?
  imageMimeType String?

  recipe           RecipeLine[]
  orderLines       OrderLine[]
  channelPrices    MenuItemChannelPrice[]
  comboSlotOptions ComboSlotOption[]
  comboSelections  ComboSelection[]
}

// قناة بيع خارجية بسعرها الخاص -- مختلفة عن OrderType (التصنيف العام
// صالة/تيك أواي/توصيل/تطبيق المستخدم في التحليلات والعروض): هذه قوائم
// أسعار قابلة للإضافة من لوحة التحكم بأي اسم (هنجر ستيشن، جاهز، مرسول...)
// بدل قيمة enum ثابتة في الكود، لأن كل مطعم يتعامل مع تطبيقات توصيل مختلفة.
model SalesChannel {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  itemPrices MenuItemChannelPrice[]
  orders     Order[]
  customers  Customer[]
}

// سعر مخصّص لصنف منيو معيّن على قناة بيع معيّنة -- إن لم يوجد سطر هنا
// لصنف/قناة بعينها، السعر الأساسي (MenuItem.price) هو المستخدم.
model MenuItemChannelPrice {
  id         String       @id @default(cuid())
  menuItemId String
  menuItem   MenuItem     @relation(fields: [menuItemId], references: [id])
  channelId  String
  channel    SalesChannel @relation(fields: [channelId], references: [id])
  price      Decimal      @db.Decimal(10, 2)

  @@unique([menuItemId, channelId])
}

// سطر وصفة: ينتمي إما لصنف منيو (menuItemId) أو لصنف نصف مصنّع بيعرّف وصفته
// هو نفسه (parentIngredientId) -- واحد منهم بالظبط، أبدًا الاثنين ولا ولا
// واحد (يُفرض بقيد CHECK في الـ migration، انظر recipe_line_exactly_one_parent).
// ingredientId هو المكوّن المُستهلك في الحالتين، ويقدر يكون خامة أو نصف
// مصنّع تاني -- وده اللي بيخلي الـ BOM متعدد المستويات فعليًا (القرار #4).
model RecipeLine {
  id                 String  @id @default(cuid())
  menuItemId         String?
  parentIngredientId String?
  ingredientId       String
  quantity           Decimal @db.Decimal(12, 3)

  menuItem         MenuItem?   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  parentIngredient Ingredient? @relation("IngredientOwnRecipe", fields: [parentIngredientId], references: [id], onDelete: Cascade)
  ingredient       Ingredient  @relation("RecipeIngredient", fields: [ingredientId], references: [id])
}

// ---------------------------------------------------------------------------
// أوامر الإنتاج (لإنتاج منتجات نصف مصنّعة) — القرار #4, #5
// ---------------------------------------------------------------------------
enum ProductionStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model ProductionOrder {
  id                 String           @id @default(cuid())
  locationId         String // مرن: قد يكون مطبخ مركزي أو فرع (القرار #5)
  outputIngredientId String // المنتج النصف مصنّع الناتج
  outputQuantity     Decimal          @db.Decimal(12, 3)
  status             ProductionStatus @default(PLANNED)
  // مجموع تكلفة المكوّنات الفعلية المستهلكة (من تكلفة كل دفعة استُهلكت
  // منها فعليًا -- ليس تقديرًا) -- تُملأ عند بدء التنفيذ (start)، وتُستخدم
  // لحساب تكلفة وحدة المنتج الناتج عند الاكتمال (complete): totalInputCost
  // / outputQuantity. تبقى null قبل البدء.
  totalInputCost     Decimal?         @db.Decimal(12, 4)
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime         @default(now())

  // shiftId + autoGenerated: set only when Sales' allowNegativeStock path
  // consumed a SEMI_FINISHED ingredient past zero -- lets the kitchen see
  // "this shift's sales created a real production need" instead of the
  // shortfall silently sitting as a negative InventoryBalance. Manually
  // created production orders leave both at their defaults (null/false).
  shiftId       String?
  autoGenerated Boolean @default(false)
  note          String?

  location         Location              @relation(fields: [locationId], references: [id])
  outputIngredient Ingredient            @relation("ProductionOutput", fields: [outputIngredientId], references: [id])
  shift            Shift?                @relation(fields: [shiftId], references: [id])
  inputs           ProductionOrderLine[]
}

// مكوّنات الإنتاج المستهلكة لإنتاج الدفعة
model ProductionOrderLine {
  id                String  @id @default(cuid())
  productionOrderId String
  ingredientId      String
  quantity          Decimal @db.Decimal(12, 3)

  productionOrder ProductionOrder @relation(fields: [productionOrderId], references: [id])
  ingredient      Ingredient      @relation(fields: [ingredientId], references: [id])
}

// ---------------------------------------------------------------------------
// الموردين والمشتريات + Approval Matrix — القرار #7, #8
// ---------------------------------------------------------------------------
model Supplier {
  id              String  @id @default(cuid())
  name            String
  phone           String?
  scopeLocationId String? // null = متاح لكل المواقع (مورد مركزي)

  purchaseOrders PurchaseOrder[]
}

enum POStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SENT_TO_SUPPLIER
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id               String   @id @default(cuid())
  locationId       String // موقع الوجهة (فرع أو مطبخ مركزي)
  supplierId       String
  status           POStatus @default(DRAFT)
  // نفس منطق Location.pricesIncludeVat لكن لكل أمر شراء على حدة -- يعتمد
  // على شكل فاتورة هذا المورد بالذات (بعض الموردين يكتبون السعر شامل
  // الضريبة، وبعضهم قبلها)، فليست خاصية ثابتة للفرع كما هي في المبيعات.
  pricesIncludeVat Boolean  @default(false)
  // subtotal: مجموع (الكمية × سعر الوحدة) كما أُدخل تمامًا، بغض النظر عن
  // كونه شامل الضريبة أو لا. vatTotal: حصيلة الضريبة فقط (تُستخرج من
  // subtotal إن كانت الأسعار شاملة، أو تُضاف عليه إن لم تكن) -- بنفس صيغة
  // OrdersService.create(). totalAmount يبقى الإجمالي النهائي (شامل
  // الضريبة دائمًا) الذي تعتمد عليه مصفوفة الموافقات (ApprovalRulesService)
  // ولا داعي لتغيير اسمه لأنه ما زال يمثّل نفس الشيء الذي كان يمثّله قبل
  // إضافة الضريبة.
  subtotal         Decimal  @default(0) @db.Decimal(12, 2)
  vatTotal         Decimal  @default(0) @db.Decimal(12, 2)
  totalAmount      Decimal  @db.Decimal(12, 2)
  createdById      String
  createdAt        DateTime @default(now())

  location  Location            @relation(fields: [locationId], references: [id])
  supplier  Supplier            @relation(fields: [supplierId], references: [id])
  lines     PurchaseOrderLine[]
  approvals Approval[]
  returns   PurchaseReturn[]
}

model PurchaseOrderLine {
  id              String  @id @default(cuid())
  purchaseOrderId String
  ingredientId    String
  quantity        Decimal @db.Decimal(12, 3)
  unitCost        Decimal @db.Decimal(12, 4)
  // يحدّد ما إذا كان هذا السطر خاضعًا للضريبة أصلًا -- بعض المواد (كالخضروات
  // الطازجة في بعض الأنظمة الضريبية) قد تكون معفاة أو بنسبة صفرية حتى لو
  // كان باقي أمر الشراء خاضعًا للضريبة العادية. نفس enum المستخدم في
  // MenuItem.taxType، بلا تكرار.
  taxType         TaxType @default(STANDARD)

  purchaseOrder PurchaseOrder        @relation(fields: [purchaseOrderId], references: [id])
  ingredient    Ingredient           @relation(fields: [ingredientId], references: [id])
  returnLines   PurchaseReturnLine[]
}

// مرتجع لمورد -- فقط لأمر شراء "مُستلم" (RECEIVED)، جزئي أو كامل حسب الكمية
// لكل سطر. عكس OrderReturn تمامًا في اتجاه المخزون: هنا نُخرج (consume) ما
// كان قد دخل فعلاً عبر receive()، بدل أن نُعيده. مبلغ الاسترداد يُحتسب من
// unitCost الأصلي في سطر أمر الشراء (ما دفعناه فعلاً للمورد)، وليس من متوسط
// تكلفة المخزون الحالي (المتغيّر بدفعات لاحقة)، لأن هذا مبلغ مستحق على
// المورد تحديدًا لا قيمة مخزون عامة.
model PurchaseReturn {
  id              String   @id @default(cuid())
  purchaseOrderId String
  reason          String?
  totalAmount     Decimal  @db.Decimal(12, 2)
  createdById     String
  createdAt       DateTime @default(now())

  purchaseOrder PurchaseOrder        @relation(fields: [purchaseOrderId], references: [id])
  createdBy     User                 @relation(fields: [createdById], references: [id])
  lines         PurchaseReturnLine[]
}

model PurchaseReturnLine {
  id                  String  @id @default(cuid())
  purchaseReturnId    String
  purchaseOrderLineId String
  quantity            Decimal @db.Decimal(12, 3)
  amount              Decimal @db.Decimal(12, 2)

  purchaseReturn    PurchaseReturn    @relation(fields: [purchaseReturnId], references: [id])
  purchaseOrderLine PurchaseOrderLine @relation(fields: [purchaseOrderLineId], references: [id])
}

// قواعد الموافقة — غير مبرمجة بالكود، تُدار من لوحة تحكم (القرار #8)
model ApprovalRule {
  id              String   @id @default(cuid())
  documentType    String // "PURCHASE_ORDER" | "STOCKTAKE_ADJUSTMENT" | ...
  maxAmount       Decimal? @db.Decimal(12, 2) // null = بلا حد أعلى (يتطلب موافقة دائمًا)
  requiredRoleId  String // الدور المخوّل بالموافقة على هذا الحد
  scopeLocationId String? // null = ينطبق على كل المواقع
}

// عام لكل أنواع المستندات اللي تمر بمصفوفة الموافقات (القرار #8) -- ليس
// حصريًا لأوامر الشراء، بدليل documentType أعلاه اللي يذكر
// STOCKTAKE_ADJUSTMENT صراحة. كل مستند له حقل FK اختياري خاص به (بالضبط
// واحد منها مربوط أيًا كان نوع المستند).
model Approval {
  id              String   @id @default(cuid())
  purchaseOrderId String?
  stocktakeId     String?
  approvedById    String
  decision        String // "APPROVED" | "REJECTED"
  note            String?
  decidedAt       DateTime @default(now())

  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  stocktake     Stocktake?     @relation(fields: [stocktakeId], references: [id])
  approvedBy    User           @relation(fields: [approvedById], references: [id])
}

// ---------------------------------------------------------------------------
// التحويلات بين المواقع — القرار #6
// ---------------------------------------------------------------------------
enum TransferStatus {
  DISPATCHED
  RECEIVED
  RECEIVED_WITH_VARIANCE
}

model Transfer {
  id             String         @id @default(cuid())
  fromLocationId String
  toLocationId   String
  status         TransferStatus @default(DISPATCHED)
  dispatchedAt   DateTime       @default(now())
  receivedAt     DateTime?

  fromLocation Location       @relation("TransferFrom", fields: [fromLocationId], references: [id])
  toLocation   Location       @relation("TransferTo", fields: [toLocationId], references: [id])
  lines        TransferLine[]
}

model TransferLine {
  id               String   @id @default(cuid())
  transferId       String
  ingredientId     String
  quantitySent     Decimal  @db.Decimal(12, 3)
  quantityReceived Decimal? @db.Decimal(12, 3) // null حتى يتم التأكيد؛ الفرق = فاقد نقل
  // تكلفة الوحدة الفعلية لما اتخصم فعليًا من موقع المصدر وقت الإرسال (من
  // نفس الدفعات، مش تقدير) -- تُستخدم لتسعير الدفعة الجديدة في موقع
  // الوجهة عند الاستلام، بنفس منطق ProductionOrder.totalInputCost.
  unitCost         Decimal? @db.Decimal(12, 4)

  transfer   Transfer   @relation(fields: [transferId], references: [id])
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])
}

// ---------------------------------------------------------------------------
// الجرد الدوري — القرار #19
// ---------------------------------------------------------------------------
model Stocktake {
  id          String    @id @default(cuid())
  locationId  String
  status      String    @default("IN_PROGRESS") // IN_PROGRESS | PENDING_APPROVAL | APPROVED
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  location  Location        @relation(fields: [locationId], references: [id])
  lines     StocktakeLine[]
  approvals Approval[]
}

model StocktakeLine {
  id              String  @id @default(cuid())
  stocktakeId     String
  ingredientId    String
  systemQuantity  Decimal @db.Decimal(12, 3) // الرصيد النظري وقت الجرد
  countedQuantity Decimal @db.Decimal(12, 3) // الكمية المعدودة فعليًا
  variance        Decimal @db.Decimal(12, 3) // counted - system

  stocktake  Stocktake  @relation(fields: [stocktakeId], references: [id])
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])
}

// ---------------------------------------------------------------------------
// العملاء والولاء — القرار #15
// ---------------------------------------------------------------------------
model Customer {
  id                    String        @id @default(cuid())
  name                  String?
  phone                 String        @unique
  // Derived running total, cached for fast reads -- LoyaltyTransaction
  // below is the actual source of truth (Phase 10c, CustomersService),
  // same "ledger + cached aggregate" split as StockMovement/InventoryBalance.
  points                Int           @default(0)
  // Ties this customer to a price list (SalesChannel) -- e.g. a delivery-
  // app aggregator's own account, a wholesale/company customer, etc.
  // OrdersService.create() applies it automatically once this customer is
  // selected on an order, UNLESS the cashier explicitly picked a different
  // salesChannelId on that specific order (an explicit choice always wins).
  // Null means "no default -- base MenuItem.price applies", same as any
  // walk-in customer today.
  defaultSalesChannelId String?
  defaultSalesChannel   SalesChannel? @relation(fields: [defaultSalesChannelId], references: [id])
  createdAt             DateTime      @default(now())

  orders              Order[]
  loyaltyTransactions LoyaltyTransaction[]
}

// نفس منطق StockMovement تمامًا: سجل حركة موقّع (موجب = كسب، سالب = استبدال/تعديل)
// + سبب + مرجع اختياري، بدل عدّاد خام بلا تدقيق (القرار #15: "Points Ledger منفصل").
model LoyaltyTransaction {
  id         String   @id @default(cuid())
  customerId String
  points     Int // موجب = كسب (ORDER_EARN)، سالب = استبدال (REDEEM) أو تعديل يدوي (MANUAL_ADJUST)
  reason     String // "ORDER_EARN" | "REDEEM" | "MANUAL_ADJUST"
  orderId    String? // الطلب الذي كسبت منه النقاط، لو كسب
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id])
}

// ---------------------------------------------------------------------------
// الطاولات — القرار #13
// ---------------------------------------------------------------------------
model Table {
  id         String @id @default(cuid())
  locationId String
  label      String // "طاولة 4"
  status     String @default("AVAILABLE") // AVAILABLE | OCCUPIED | NEEDS_CLEANING

  orders Order[]
}

// ---------------------------------------------------------------------------
// الورديات وتسوية النقدية — القرار #12
// ---------------------------------------------------------------------------
model Shift {
  id                String    @id @default(cuid())
  locationId        String
  openedById        String
  closedById        String?
  openingFloat      Decimal   @db.Decimal(12, 2)
  closingCounted    Decimal?  @db.Decimal(12, 2) // ما تم عدّه فعليًا عند الإغلاق
  expectedCash      Decimal?  @db.Decimal(12, 2) // ما يُفترض وجوده حسابيًا
  variance          Decimal?  @db.Decimal(12, 2) // Over/Short
  openedAt          DateTime  @default(now())
  closedAt          DateTime?
  // آخر رقم فاتورة صادر لهذه الوردية -- يُزاد ذريًا (increment) عند كل طلب
  // جديد بدل عدّ الطلبات الموجودة، لتفادي تعارض رقمين متطابقين لو وصل
  // طلبان في نفس اللحظة (orders.service.ts create()).
  lastOrderSequence Int       @default(0)
  // Human-friendly "SH{n}" number for this shift, assigned atomically from
  // Location.lastShiftNumber when the shift is opened. Nullable rather than
  // backfilled for shifts that existed before this field -- same "old rows
  // just show '-'" approach shiftSequence/dailySequence already established.
  shiftNumber       Int?
  // Computed ONCE here at open time via computeBusinessDate() (common/
  // business-date.util.ts) -- every order created on this shift copies it
  // verbatim (Order.businessDate below), so a shift opened at 5am and
  // still running past midnight keeps ALL its orders on the SAME business
  // date instead of an order placed at 1am silently rolling onto
  // tomorrow's ledger. Nullable and not backfilled for shifts that
  // existed before this field, same precedent as shiftNumber above --
  // code reading it falls back to startOfUtcDay(openedAt) for those.
  businessDate      DateTime? @db.Date

  location         Location          @relation(fields: [locationId], references: [id])
  openedBy         User              @relation("ShiftOpenedBy", fields: [openedById], references: [id])
  closedBy         User?             @relation("ShiftClosedBy", fields: [closedById], references: [id])
  orders           Order[]
  productionOrders ProductionOrder[]
}

// ---------------------------------------------------------------------------
// الطلبات والمبيعات — القرار #2, #3, #10, #11, #14, #18
// ---------------------------------------------------------------------------
// أنواع الطلبات (صالة/تيك أواي/توصيل...) -- جدول قابل للإدارة من الإعدادات
// بدل enum ثابت في الكود، بنفس نمط PaymentMethod: code مستقر لا يتغيّر (تُخزَّن
// عليه كل Order.channel/Promotion.channelLimit القديمة والجديدة)، name/icon
// قابلان للتعديل، isActive يُخفي النوع من واجهات الاختيار الجديدة دون كسر
// الطلبات التاريخية التي تحمل كوده. منفصل تمامًا عن SalesChannel (قائمة
// الأسعار) -- الاثنان قد يبدوان متشابهين بالاسم لكنهما مفهومان مختلفان.
model OrderType {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  icon      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

enum OrderStatus {
  OPEN
  SENT_TO_KITCHEN
  READY
  PAID
  VOIDED
}

// نقدية: تُدفع عند البيع (الوضع الافتراضي). آجلة: تُفوتر لعميل محدد ليُسوَّى
// حسابه لاحقًا -- تتطلب customerId (القرار في orders.service.ts create()).
// لا تُغيّر أي منطق دفع/تعليق موجود، هي تصنيف على الفاتورة فقط.
enum InvoiceType {
  CASH
  CREDIT
}

model Order {
  id                       String      @id @default(cuid())
  // A single global auto-increment across every order regardless of
  // branch/shift/day -- distinct from shiftSequence/dailySequence below
  // (each of which restarts at 1 per shift/day and is what prints on the
  // invoice), and from `id` itself (a cuid, meaningless to a human). This
  // is purely an internal, always-increasing reference for admin screens
  // (e.g. sorting/searching the Orders report by DB insertion order).
  sequenceNumber           Int         @unique @default(autoincrement())
  locationId               String
  tableId                  String?
  customerId               String?
  shiftId                  String?
  // يخزّن OrderType.code (نص مستقر، وليس مفتاحًا أجنبيًا) -- نفس نمط
  // PaymentMethod.code في Payment، يبقى صالحًا حتى لو أُلغي تفعيل/حُذف
  // نوع الطلب لاحقًا. يُتحقق من وجوده وتفعيله عند الإنشاء في orders.service.ts.
  channel                  String
  // اختياري -- عند تحديده، سطور الطلب تُسعَّر بقائمة أسعار هذه القناة
  // (MenuItemChannelPrice) بدل السعر الأساسي، منفصل تمامًا عن OrderType
  // أعلاه (التصنيف العام لأغراض العروض/التحليلات).
  salesChannelId           String?
  invoiceType              InvoiceType @default(CASH)
  // أرقام فاتورة قابلة للقراءة، منفصلة تمامًا عن zatcaInvoiceCounter (وهو
  // تسلسل ZATCA الرسمي على مستوى الفرع بأكمله ولا يجوز كسره). shiftSequence
  // يبدأ من 1 مع كل وردية جديدة (لا علاقة له بمعرّف/اسم الوردية نفسه)،
  // dailySequence يبدأ من 1 مع كل يوم تقويمي جديد لنفس الفرع، عبر كل
  // الورديات في ذلك اليوم. تُحسب ذريًا داخل معاملة create() في orders.service.ts.
  shiftSequence            Int?
  dailySequence            Int?
  status                   OrderStatus @default(OPEN)
  servedById               String?
  subtotal                 Decimal     @db.Decimal(12, 2)
  discountTotal            Decimal     @default(0) @db.Decimal(12, 2)
  // Phase 10b: set only when discountTotal came from the Promotions engine
  // auto-applying an active Promotion (not when a cashier passed a manual
  // discountTotal directly) -- an audit trail for which deal actually fired.
  promotionId              String?
  vatTotal                 Decimal     @db.Decimal(12, 2)
  grandTotal               Decimal     @db.Decimal(12, 2)
  // ZATCA — القرار #3: تولَّد وتُوقَّع محليًا وقت البيع (Phase 9, ZatcaService).
  // zatcaSyncStatus: PENDING (لم تُولَّد بعد -- الوضع الافتراضي قبل الدفع، ويبقى
  // كذلك لو الموقع بلا vatNumber مُعدّ) | GENERATED (وُلّدت ووُقّعت محليًا فعليًا،
  // جاهزة للرفع) | SYNCED (رُفعت واعتُمدت فعليًا من فاتورة) | FAILED (رُفضت من فاتورة).
  // لا يوجد بيئة اعتماد ZATCA حقيقية متاحة هنا، فـ SYNCED لن يظهر عمليًا حتى تُوصَّل
  // بيانات اعتماد حقيقية عبر ZatcaService.submitToZatca.
  zatcaUuid                String?
  zatcaQrCode              String?     @db.Text
  zatcaSignature           String?     @db.Text
  zatcaInvoiceHash         String?     @db.Text
  zatcaXml                 String?     @db.Text
  zatcaPublicKey           String?     @db.Text
  zatcaSyncStatus          String      @default("PENDING")
  // Invoice Counter Value (ICV) and Previous Invoice Hash (PIH): ZATCA's
  // chaining requirement so every reported invoice references the one
  // immediately before it at the same location (tamper-evidence -- you
  // can't delete/reorder an invoice without breaking the chain). PIH is
  // base64 of the HEX STRING of the previous invoice's hash (not raw
  // bytes -- a documented ZATCA quirk, different from the QR's tag 6
  // which IS raw bytes); the very first invoice at a location uses
  // ZATCA's published genesis value for SHA-256("0") (see zatca.service.ts).
  zatcaInvoiceCounter      Int?
  zatcaPreviousInvoiceHash String?     @db.Text
  createdAt                DateTime    @default(now())
  paidAt                   DateTime?
  // Set the moment kitchen staff dismiss a cancelled order's ticket from
  // the KDS board (KitchenService.acknowledgeCancel) -- null means a
  // VOIDED order with a line the kitchen hadn't finished yet is still
  // owed an explicit "stop cooking this" notice, so KitchenService.queue()
  // keeps surfacing it. Irrelevant for an order that was never VOIDED.
  kitchenCancelAckAt       DateTime?
  // Copied verbatim from the parent shift's own businessDate at creation
  // time (OrdersService.create()) -- every order on the same shift shares
  // one business date however late into the next calendar day the shift
  // itself runs. Nullable, same "not backfilled for pre-existing rows"
  // precedent as Shift.businessDate/shiftNumber.
  businessDate             DateTime?   @db.Date

  location     Location           @relation("OrderLocation", fields: [locationId], references: [id])
  table        Table?             @relation(fields: [tableId], references: [id])
  customer     Customer?          @relation(fields: [customerId], references: [id])
  shift        Shift?             @relation(fields: [shiftId], references: [id])
  servedBy     User?              @relation("OrderServedBy", fields: [servedById], references: [id])
  promotion    Promotion?         @relation(fields: [promotionId], references: [id])
  salesChannel SalesChannel?      @relation(fields: [salesChannelId], references: [id])
  lines        OrderLine[]
  payments     Payment[]
  returns      OrderReturn[]
  activityLog  OrderActivityLog[]
}

// عدّاد يومي منفصل لكل فرع -- صف واحد لكل (locationId, date)، يُزاد ذريًا عبر
// upsert (INSERT ... ON CONFLICT DO UPDATE) في orders.service.ts create() بدل
// عدّ طلبات اليوم الحالي، لتفادي رقمين متطابقين لو وصل طلبان من فرعين
// مختلفين -- أو نفس الفرع -- في نفس اللحظة تمامًا.
model DailyInvoiceCounter {
  locationId String
  date       DateTime @db.Date
  counter    Int      @default(0)

  @@id([locationId, date])
}

// سجل حركة صغير لأحداث الطلب التي لا تُشتقّ من حقول الطلب نفسها (بخلاف
// createdAt/paidAt) -- حاليًا يسجّل فقط "تعليق الفاتورة" (HELD): الكاشير
// يضغط تعليق بدل الدفع فورًا، فيبقى الطلب بحالته الحالية (غير مدفوع) لكن مع
// أثر صريح لمن علّقها ومتى ولماذا، بدل الاعتماد على مجرد "لم يُدفع بعد" التي
// لا تُفرّق بين "لم يصل الكاشير له بعد" و"عُلّق عمدًا".
model OrderActivityLog {
  id          String   @id @default(cuid())
  orderId     String
  action      String // HELD / VOIDED / RETURNED / RETURN_KITCHEN_BLOCK_OVERRIDDEN
  note        String?
  createdById String
  createdAt   DateTime @default(now())

  order     Order @relation(fields: [orderId], references: [id])
  createdBy User  @relation(fields: [createdById], references: [id])
}

// حالة تحضير كل عنصر بشكل مستقل — ضرورية لـ KDS (القرار #11)
enum KitchenLineStatus {
  QUEUED
  PREPARING
  READY
  SERVED
}

// menuItemId XOR comboMealId -- exactly one of them, never both/neither
// (enforced in OrdersService.create(), same "exactly one parent" shape
// RecipeLine already uses for menuItemId/parentIngredientId). A combo line
// stores no recipe/cost of its own: comboSelections below records exactly
// which item the cashier picked per slot, and THAT is what inventory is
// actually consumed against and what the kitchen ticket/invoice show.
model OrderLine {
  id            String            @id @default(cuid())
  orderId       String
  menuItemId    String?
  comboMealId   String?
  quantity      Int
  unitPrice     Decimal           @db.Decimal(10, 2)
  // Free-text instruction from the cashier for the kitchen (e.g. "بدون
  // بصل" / "extra spicy") -- shown under this line on the invoice, the
  // KDS ticket, and the printable kitchen ticket. Never affects pricing
  // or inventory, purely informational.
  note          String?
  kitchenStatus KitchenLineStatus @default(QUEUED)
  // Stamped by KitchenService.advanceStatus() the moment kitchenStatus
  // transitions to READY -- lets a kitchen-performance report measure
  // order.createdAt -> readyAt (prep time) per line without conflating it
  // with pay() timing (an order can be paid well before or after its food
  // is actually ready, so paidAt is not a usable proxy for this).
  readyAt       DateTime?

  order           Order             @relation(fields: [orderId], references: [id])
  menuItem        MenuItem?         @relation(fields: [menuItemId], references: [id])
  comboMeal       ComboMeal?        @relation(fields: [comboMealId], references: [id])
  comboSelections ComboSelection[]
  returnLines     OrderReturnLine[]
}

// وجبة كمبو/بوكس: سعر أساسي + عدد غير محدود من "الفئات" (comboSlots) —
// كل فئة (مثلاً "الطبق الرئيسي") تحدد أقل/أكثر عدد اختيارات مسموح بها من
// قائمة خياراتها الخاصة (comboSlotOptions)، وكل خيار قد يضيف فرق سعر
// اختياريًا فوق السعر الأساسي (upcharge)، فيدعم الكمبو ثابت السعر تمامًا
// (كل الخيارات extraPrice=0) والكمبو متغيّر السعر حسب الاختيار في آن واحد
// بنفس البنية، دون تفريع منطقي. متاح لكل الفروع (لا يوجد ربط بموقع).
model ComboMeal {
  id         String      @id @default(cuid())
  name       String
  // Nullable, unlike MenuItem.category (required) -- an uncategorized
  // combo still shows in the New Order menu grid under a generic "كمبو"
  // fallback group (see admin_panel.html's renderOrderCategories/
  // renderOrderMenuGrid) rather than being rejected outright, since this
  // field is new and existing combos predate it.
  category   String?
  basePrice  Decimal     @db.Decimal(10, 2)
  isActive   Boolean     @default(true)
  createdAt  DateTime    @default(now())
  slots      ComboSlot[]
  orderLines OrderLine[]
}

model ComboSlot {
  id          String @id @default(cuid())
  comboMealId String
  label       String // مثال: "الطبق الرئيسي"، "المشروب"
  minSelect   Int    @default(1)
  maxSelect   Int    @default(1)
  sortOrder   Int    @default(0)

  comboMeal  ComboMeal         @relation(fields: [comboMealId], references: [id], onDelete: Cascade)
  options    ComboSlotOption[]
  selections ComboSelection[]
}

model ComboSlotOption {
  id          String  @id @default(cuid())
  comboSlotId String
  menuItemId  String
  extraPrice  Decimal @default(0) @db.Decimal(10, 2)

  comboSlot ComboSlot @relation(fields: [comboSlotId], references: [id], onDelete: Cascade)
  menuItem  MenuItem  @relation(fields: [menuItemId], references: [id])

  @@unique([comboSlotId, menuItemId])
}

// السجل الفعلي لِما اختاره الزبون فعلًا لكل فئة عند إضافة الكمبو للطلب --
// extraPrice هنا هو لقطة (snapshot) من ComboSlotOption.extraPrice وقت
// الطلب، فتغيير سعر خيار مستقبلًا لا يُغيّر فواتير سابقة، بنفس مبدأ
// OrderLine.unitPrice الذي يُجمّد سعر البيع وقت الطلب لا وقت القراءة.
model ComboSelection {
  id          String  @id @default(cuid())
  orderLineId String
  comboSlotId String
  menuItemId  String
  quantity    Int     @default(1)
  extraPrice  Decimal @db.Decimal(10, 2)

  orderLine OrderLine @relation(fields: [orderLineId], references: [id], onDelete: Cascade)
  comboSlot ComboSlot @relation(fields: [comboSlotId], references: [id])
  menuItem  MenuItem  @relation(fields: [menuItemId], references: [id])
}

// مرتجع عميل -- لطلب مدفوع بالكامل فقط (PAID)، جزئي أو كامل حسب الكمية لكل
// سطر. مختلف عن VOIDED (إلغاء طلب لم يُدفَع بعد): هنا الدفع تم فعلاً، فالمرتجع
// يسجّل مبلغ استرداد صريح + يعيد المخزون المستهلك لنفس الأصناف المُرجَعة، بدل
// مجرد إلغاء الطلب بالكامل.
model OrderReturn {
  id                       String   @id @default(cuid())
  orderId                  String
  reason                   String?
  refundTotal              Decimal  @db.Decimal(12, 2)
  createdById              String
  createdAt                DateTime @default(now())
  // ZATCA credit note (نطاق موازٍ تمامًا لحقول Order.zatca* أعلاه، لكن
  // لمستند ائتمان بدل فاتورة) -- تُولَّد وتُوقَّع محليًا داخل نفس معاملة
  // ReturnsService.create()/voidPaidOrder()، بنفس منطق ZatcaService.
  // ICV/PIH لهذا المستند يشتركان في نفس سلسلة الفرع (Location.zatcaInvoiceCounter)
  // التي تستخدمها الفواتير العادية -- ZATCA تتوقع سلسلة واحدة موحّدة زمنيًا
  // لكل مستندات الفرع (فواتير + إشعارات دائن)، وليست سلسلتين منفصلتين.
  zatcaUuid                String?
  zatcaQrCode              String?  @db.Text
  zatcaSignature           String?  @db.Text
  zatcaInvoiceHash         String?  @db.Text
  zatcaXml                 String?  @db.Text
  zatcaPublicKey           String?  @db.Text
  zatcaSyncStatus          String   @default("PENDING")
  zatcaInvoiceCounter      Int?
  zatcaPreviousInvoiceHash String?  @db.Text

  order       Order                    @relation(fields: [orderId], references: [id])
  createdBy   User                     @relation(fields: [createdById], references: [id])
  lines       OrderReturnLine[]
  activityLog OrderReturnActivityLog[]
}

model OrderReturnLine {
  id           String  @id @default(cuid())
  returnId     String
  orderLineId  String
  quantity     Int
  refundAmount Decimal @db.Decimal(12, 2)
  // لقطة (snapshot) من تفكيك refundAmount وقت الإرجاع -- net + vat = refundAmount
  // دائمًا (net فقط لو الصنف ZERO_RATED/EXEMPT أو الفرع pricesIncludeVat)، محفوظة
  // بدل إعادة حسابها لاحقًا حتى لا يختلف عرض المرتجع عن المبلغ المسجَّل فعليًا
  // لو تغيّر لاحقًا سعر الضريبة/إعداد الفرع.
  netAmount    Decimal @default(0) @db.Decimal(12, 2)
  vatAmount    Decimal @default(0) @db.Decimal(12, 2)

  return    OrderReturn @relation(fields: [returnId], references: [id])
  orderLine OrderLine   @relation(fields: [orderLineId], references: [id])
}

// سجل تدقيق مستقل خاص بكل مرتجع على حدة (بخلاف OrderActivityLog الذي يسجّل
// حركة الطلب ككل) -- مفيد عندما يكون لنفس الطلب أكثر من مرتجع، فيتيح تتبّع
// تاريخ كل مرتجع بمعزل عن الآخر: إنشاؤه، ثم توليد إشعار الدائن الضريبي له.
model OrderReturnActivityLog {
  id          String   @id @default(cuid())
  returnId    String
  action      String // CREATED / ZATCA_CREDIT_NOTE_GENERATED
  note        String?
  createdById String
  createdAt   DateTime @default(now())

  return    OrderReturn @relation(fields: [returnId], references: [id])
  createdBy User        @relation(fields: [createdById], references: [id])
}

enum PaymentMode {
  INTEGRATED
  MANUAL
}

model Payment {
  id          String      @id @default(cuid())
  orderId     String
  // Free string on purpose, matching whatever PaymentMethod.code was
  // active when this payment happened -- never a FK to PaymentMethod,
  // so deactivating/renaming a method later can't orphan or rewrite
  // historical payment records.
  method      String // "CASH" | "CARD" | "WALLET" | any PaymentMethod.code
  mode        PaymentMode
  amount      Decimal     @db.Decimal(12, 2)
  terminalRef String? // معرف العملية من جهاز الدفع (للتكامل المباشر)
  createdAt   DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id])
}

// طرق الدفع القابلة للإدارة -- بدل قائمة مُثبَّتة بالكود (CASH/CARD/WALLET)،
// كل منشأة قد تحتاج طرقًا إضافية (الدفع عند الاستلام لتطبيقات التوصيل، شبكة
// مدى...). isCash يُستخدم حصرًا لتحديد أي الطرق تُحتسب ضمن تسوية صندوق
// الوردية النقدي (ShiftsService.close) -- طريقة واحدة أو أكثر يمكن
// وسمها كنقدية، والباقي (بطاقة/محفظة/تطبيقات) لا يُصفَّى إلا عبر جهات
// التسوية الخاصة بها.
model PaymentMethod {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  isCash    Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// العروض — القرار #14
// ---------------------------------------------------------------------------
enum PromotionType {
  PERCENTAGE_DISCOUNT
  FIXED_DISCOUNT
  BOGO
  COMBO
}

model Promotion {
  id           String        @id @default(cuid())
  name         String
  type         PromotionType
  value        Decimal?      @db.Decimal(10, 2) // نسبة أو مبلغ حسب النوع
  channelLimit String? // OrderType.code -- null = كل القنوات
  startsAt     DateTime?
  endsAt       DateTime?
  isActive     Boolean       @default(true)

  // Phase 10b (PromotionsService): auto-applies PERCENTAGE_DISCOUNT/
  // FIXED_DISCOUNT only. BOGO/COMBO stay valid enum values for future
  // work but are rejected at creation time -- they need per-line
  // qualifying-item logic the engine doesn't implement yet, so the API
  // refuses to save configuration that would silently never take effect.
  orders Order[]
}

// ---------------------------------------------------------------------------
// تقارير مُصدَّرة (Excel/PDF) -- تكرار ما بعد خطة التنفيذ الأصلية، فوق طبقة
// BI للقراءة فقط في src/analytics/. الملف الفعلي يُخزَّن هنا (bytea) لبساطة
// التقارير المتوقعة (كيلوبايتات قليلة) بلا حاجة لتخزين كائنات خارجي، ولأن
// بيئة التطوير هذه لا تملك بيانات اعتماد لأي خدمة تخزين سحابي فعلية.
model GeneratedReport {
  id          String   @id @default(cuid())
  type        String // "DAILY_BUNDLE" (حاليًا النوع الوحيد -- ملخص مبيعات + أصناف + تكلفة طعام + نقص مخزون في ملف واحد)
  format      String // "XLSX" | "PDF"
  locationId  String? // null = كل المواقع (تقرير على مستوى المؤسسة)
  periodStart DateTime
  periodEnd   DateTime
  fileName    String
  fileData    Bytes
  createdAt   DateTime @default(now())
}

// ---------------------------------------------------------------------------
// النسخ الاحتياطي — مديول كامل لتصدير/استعادة قاعدة البيانات بأكملها
// ---------------------------------------------------------------------------
// A full logical dump of every table (see BackupService.MODEL_ORDER),
// serialized to JSON and gzip-compressed, stored the same "no external
// object storage" way GeneratedReport.fileData already is. Deliberately
// broader than AdminService.fullWipe/resetMasterData -- this INCLUDES
// Users/Roles/Permissions, because a restore is meant to bring a database
// (e.g. a freshly-deployed empty environment) to an exact byte-for-byte
// copy of another one, not just re-seed product/catalog data.
model Backup {
  id        String   @id @default(cuid())
  // Who/what triggered this backup -- a User.id for an on-demand backup
  // (POST /backups), or the literal string "SYSTEM_CRON" for the daily
  // scheduled one, which has no acting user.
  createdBy String
  note      String?
  fileName  String
  sizeBytes Int // حجم fileData بعد الضغط -- لعرض قائمة النسخ دون تحميل كل bytea
  fileData  Bytes
  createdAt DateTime @default(now())
}
